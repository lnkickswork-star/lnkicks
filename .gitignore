# Workspace internal — do not track
skills/
upload/
tool-results/
# Ignore all of scripts/ EXCEPT scripts/deploy/ (CI/CD pipeline files
# that MUST be committed to git so GitHub Actions can use them).
scripts/*
!scripts/deploy/
tsconfig.tsbuildinfo

# === From remote main ===
# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Production builds
build/
dist/

# Coverage directory
coverage/

# Temporary files and cache
.tmp/
.cache/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# === Local additions: secrets ===
.env
.env.local
.env.*.local
download/
tool-results/
.vercel
# Ignore all .env* files EXCEPT the example template (which is safe to
# commit — it contains only placeholder values, no real secrets).
.env*
!.env.production.example
