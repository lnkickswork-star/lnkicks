# =============================================================================
# LN KICKS — .env.production template (FOR SERVER USE ONLY)
# =============================================================================
#
# This file is for the FILE MODE of setup-env-vars.sh:
#
#   bash setup-env-vars.sh /path/to/.env.production
#
# Fill in your real values below, upload this file to the server (via SCP
# or cPanel File Manager), then run setup-env-vars.sh pointing to it.
#
# After setup-env-vars.sh runs, this file is NO LONGER NEEDED — the vars
# are written to the cPanel nodevenv etc/envvars file (which is sourced
# automatically by bin/activate). You can delete this file from the server
# after setup is complete.
#
# ⚠️  NEVER commit a filled-in version of this file to git.
# ⚠️  The .gitignore already excludes .env* files (except .example).
# =============================================================================
#
# AUTO-GENERATED from a full audit of every `process.env.*` and `env("*")`
# reference in the codebase. Lists ONLY variables actually read by code.
#
# User-set vars (configure EITHER here OR in cPanel UI — not both):
#   DATABASE_URL                  REQUIRED
#   DIRECT_URL                    REQUIRED
#   NEXT_PUBLIC_SITE_URL          RECOMMENDED
#   NEXT_PUBLIC_WHATSAPP_NUMBER   RECOMMENDED
#
# Auto-set vars (DO NOT configure manually — set by Next.js / LiteSpeed / OS):
#   NODE_ENV, PORT, HOSTNAME, LSNODE_SOCKET, HOME
#
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — app will refuse to start without these.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL pooled connection (used by the app at runtime).
# MUST include ?sslmode=require. If using Neon's pooler, also add &pgbouncer=true.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# PostgreSQL direct connection (used by Prisma CLI for migrations).
# MUST include ?sslmode=require. On Neon: non-pooler hostname.
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED — app starts without these, but logs show ❌ at boot if missing.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# WhatsApp business number (country code + number, no +, no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=918881286267

# =============================================================================
# END OF FILE — no other env vars are read by the application code.
# =============================================================================
