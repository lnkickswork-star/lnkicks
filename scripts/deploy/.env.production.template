# =============================================================================
# LN KICKS — .env.production template (FOR SERVER USE ONLY)
# =============================================================================
#
# This file is for the FILE MODE of setup-env-vars.sh:
#
#   bash setup-env-vars.sh /path/to/.env.production
#
# Fill in your real values below, upload this file to the server (via SCP
# or cPanel File Manager), then run setup-env-vars.sh pointing to it.
#
# After setup-env-vars.sh runs, this file is NO LONGER NEEDED — the vars
# are written to the cPanel nodevenv etc/envvars file (which is sourced
# automatically by bin/activate). You can delete this file from the server
# after setup is complete.
#
# ⚠️  NEVER commit a filled-in version of this file to git.
# ⚠️  The .gitignore already excludes .env* files (except .example).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — app will not work without these.
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=https://lnkicks.com
NEXT_PUBLIC_WHATSAPP_NUMBER=918881286267

# ─────────────────────────────────────────────────────────────────────
# AUTHENTICATION — generate with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_JWT_SECRET=
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────
# DATABASE — fill in either MySQL OR PostgreSQL, not both.
# ─────────────────────────────────────────────────────────────────────
# MySQL (cPanel default — create DB in cPanel → MySQL Databases first):
MYSQL_HOST=localhost
MYSQL_DATABASE=aqualit1_lnkicks
MYSQL_USER=aqualit1_lnkicks
MYSQL_PASSWORD=

# PostgreSQL (Supabase, Neon, etc. — leave blank if using MySQL):
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAY — fill in the one(s) you use.
# ─────────────────────────────────────────────────────────────────────
# Stripe:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay (India):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────────────────────────────
# EMAIL / SMTP — leave blank to use cPanel local mail server.
# ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LN KICKS <noreply@lnkicks.com>

# ─────────────────────────────────────────────────────────────────────
# SECURITY / RATE LIMITING
# ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://lnkicks.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ─────────────────────────────────────────────────────────────────────
# APP METADATA
# ─────────────────────────────────────────────────────────────────────
APP_NAME=LN KICKS
LOG_LEVEL=info
TZ=Asia/Kolkata
