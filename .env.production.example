# =============================================================================
# LN KICKS — Production Environment Variables Template
# =============================================================================
#
# This file is a TEMPLATE. It documents every environment variable the app
# reads. Real values must NEVER be committed to git.
#
# There are TWO places env vars must be set:
#
#   1. GitHub Secrets (for build-time vars — used by `next build`)
#      Repo → Settings → Secrets and variables → Actions → New repository secret
#      Any var prefixed with NEXT_PUBLIC_ MUST be set here, because Next.js
#      inlines NEXT_PUBLIC_* vars into the client bundle at build time.
#
#   2. cPanel Environment Variables (for runtime vars — used by `next start`)
#      cPanel → Software → Setup Node.js App → Edit your app →
#      "Environment variables" section → Add each var.
#      These are stored in a `.env` file inside the app root on the server.
#      Server-only secrets (DB passwords, JWT secret, payment gateway keys,
#      etc.) belong here ONLY.
#
# WHY BOTH?
#   - NEXT_PUBLIC_* vars are baked into the client bundle at build time, so
#     they MUST be in GitHub Secrets.
#   - Server-only vars (no NEXT_PUBLIC_ prefix) are read from process.env at
#     runtime, so they only need to be in cPanel.
#   - Some vars (like NEXT_PUBLIC_SITE_URL) appear in both places — GitHub
#     Secrets for the build, cPanel for runtime server-side code that reads
#     them. It's safe to set them in both.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE CONFIG (build-time + runtime — set in BOTH GitHub Secrets AND cPanel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_WHATSAPP_NUMBER=918881286267

# -----------------------------------------------------------------------------
# ANALYTICS (build-time — set in GitHub Secrets only if used by the app)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FB_PIXEL_ID=1234567890

# -----------------------------------------------------------------------------
# AUTHENTICATION (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# JWT_SECRET=<generate with: openssl rand -base64 48>
# ADMIN_JWT_SECRET=<generate with: openssl rand -base64 48>
# SESSION_SECRET=<generate with: openssl rand -base64 48>

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL (production DB for LN KICKS)
# Set in cPanel only (runtime). Get these from your Postgres provider's
# dashboard (Supabase / Neon / Railway / Render / self-hosted).
# ALWAYS include ?sslmode=require for managed Postgres providers.
# -----------------------------------------------------------------------------
# DATABASE_URL     — pooled connection (PgBouncer / Supabase pooler).
#                    Used by the app at runtime for queries.
# DIRECT_URL       — direct connection (bypasses pooler).
#                    Used by Prisma / migration tools for DDL.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# LEGACY MySQL — only uncomment if you switch away from PostgreSQL.
# cPanel shared hosting includes MySQL by default, but LN KICKS uses
# Postgres. Leave these commented unless you have a specific reason.
# -----------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_DATABASE=aqualit1_lnkicks
# MYSQL_USER=aqualit1_lnkicks
# MYSQL_PASSWORD=

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# Stripe:
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx   (also NEXT_PUBLIC_ if used client-side)
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
#
# Razorpay (India):
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx

# -----------------------------------------------------------------------------
# EMAIL / NOTIFICATIONS (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASSWORD=xxx
# SMTP_FROM="LN KICKS <noreply@your-domain.com>"

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS API (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# WHATSAPP_BUSINESS_TOKEN=xxx
# WHATSAPP_PHONE_NUMBER_ID=xxx

# -----------------------------------------------------------------------------
# FILE UPLOADS / CDN (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# Cloudinary:
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxx

# -----------------------------------------------------------------------------
# RATE LIMITING / SECURITY (runtime — set in cPanel only)
# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# CORS_ORIGIN=https://your-production-domain.com

# -----------------------------------------------------------------------------
# APP METADATA (build-time + runtime)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
